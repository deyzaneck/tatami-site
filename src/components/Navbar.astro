---
import headerLogo from '../assets/tatami-header-logo.png';
import { CLUB, NAV_ITEMS } from '../data/site';
---
<header class="site-header">
  <div class="tatami-container header-row">
    <a href="#hero" class="brand-link" aria-label="Татами спортивный клуб — наверх"><img src={headerLogo.src} width={headerLogo.width} height={headerLogo.height} alt="Татами — спортивный клуб" class="header-logo" /></a>
    <nav class="desktop-nav" aria-label="Основная навигация">
      {NAV_ITEMS.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="header-actions">
      <a href="#signup" class="btn-header header-signup">Записаться</a>
      <button type="button" id="mobile-menu-toggle" aria-label="Открыть меню" aria-expanded="false" aria-controls="mobile-menu-drawer">
        <svg id="menu-icon-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" /></svg>
        <svg id="menu-icon-close" class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" d="m6 6 12 12M6 18 18 6" /></svg>
      </button>
    </div>
  </div>
  <div id="mobile-menu-drawer" class="hidden">
    <div class="tatami-container mobile-nav-content">
      <nav aria-label="Мобильная навигация">{NAV_ITEMS.map((item) => <a href={item.href} data-mobile-nav-link>{item.label}</a>)}</nav>
      <div class="mobile-contact"><a href={CLUB.telegramAdmin} target="_blank" rel="noopener noreferrer">Администратор в Telegram</a><p>{CLUB.addressFull}</p></div>
    </div>
  </div>
</header>
<script>
  const btn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-menu-drawer');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  if (btn && drawer) {
    const setOpen = (isOpen: boolean) => {
      drawer.classList.toggle('hidden', !isOpen);
      btn.setAttribute('aria-expanded', String(isOpen));
      btn.setAttribute('aria-label', isOpen ? 'Закрыть меню' : 'Открыть меню');
      iconOpen?.classList.toggle('hidden', isOpen);
      iconClose?.classList.toggle('hidden', !isOpen);
    };
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    drawer.querySelectorAll('[data-mobile-nav-link]').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { setOpen(false); btn.focus(); }
    });
  }
</script>
<style>
  .site-header { position: fixed; top: 0; left: 0; right: 0; z-index: 50; background: var(--bg-deep); border-bottom: 1px solid var(--seam); }
  .header-row { display: flex; min-height: 80px; align-items: center; justify-content: space-between; gap: 16px; }
  .brand-link { flex-shrink: 0; }
  .header-logo { display: block; width: clamp(104px, 18vw, 176px); height: auto; }
  .desktop-nav { display: none; }
  .header-actions { display: flex; align-items: center; gap: 8px; }
  #mobile-menu-toggle {
    display: grid; place-items: center; width: 40px; height: 40px;
    background: var(--raised); border: 1px solid rgb(232 227 217 / 14%); border-radius: 8px;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 8%);
    transition: background-color 160ms var(--ease), border-color 160ms var(--ease), transform 140ms var(--ease);
  }
  #mobile-menu-toggle:hover { background: #2c2c2a; border-color: rgb(232 227 217 / 28%); }
  #mobile-menu-toggle:active { transform: scale(0.98); }
  @media (max-width: 379px) { .header-signup { padding-inline: 12px; } }
  @media (min-width: 400px) { .header-actions { gap: 12px; } }
  #mobile-menu-drawer { border-top: 1px solid var(--hairline); max-height: calc(100dvh - 80px); overflow-y: auto; overscroll-behavior: contain; }
  .mobile-nav-content { padding-block: 16px 24px; }
  .mobile-nav-content nav { display: grid; }
  .mobile-nav-content nav a { padding-block: 12px; color: var(--secondary); }
  .mobile-nav-content a:hover { color: var(--text); }
  .mobile-contact { padding-top: 16px; margin-top: 16px; border-top: 1px solid var(--hairline); }
  .mobile-contact p { margin-top: 8px; color: var(--secondary); font-size: 14px; }
  @media (min-width: 1200px) {
    .desktop-nav { display: flex; gap: 24px; color: var(--secondary); font-size: 14px; }
    .desktop-nav a { padding-block: 12px; }
    .desktop-nav a:hover { color: var(--text); }
    #mobile-menu-toggle, #mobile-menu-drawer { display: none; }
  }
</style>
