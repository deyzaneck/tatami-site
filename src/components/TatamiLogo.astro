---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  uid?: string;
  showSubtitle?: boolean;
  class?: string;
}

const { size = 'sm', uid = 'logo', showSubtitle = true, class: className = '' } = Astro.props;

const sizeClasses = {
  sm: 'w-[148px] sm:w-[168px]',
  md: 'w-[200px] sm:w-[230px]',
  lg: 'w-[240px] sm:w-[300px]',
}[size];

const gradMetalId = `${uid}-metal`;
const gradBeltId = `${uid}-belt`;
const glowId = `${uid}-glow`;
const strokeId = `${uid}-stroke`;
---

<div class={`inline-flex flex-col select-none ${sizeClasses} ${className}`}>
  <svg
    viewBox="0 0 360 112"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-auto overflow-visible"
    role="img"
    aria-label="Спортивный клуб Татами — логотип с черным поясом"
  >
    <defs>
      <linearGradient id={gradMetalId} x1="0" y1="18" x2="0" y2="96" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#FFFFFF" />
        <stop offset="46%" stop-color="#D4D4D8" />
        <stop offset="78%" stop-color="#8C8C96" />
        <stop offset="100%" stop-color="#52525B" />
      </linearGradient>

      <linearGradient id={gradBeltId} x1="210" y1="6" x2="325" y2="108" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#27272A" />
        <stop offset="50%" stop-color="#111114" />
        <stop offset="100%" stop-color="#050507" />
      </linearGradient>

      <linearGradient id={strokeId} x1="0" y1="0" x2="360" y2="100" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.7" />
        <stop offset="50%" stop-color="#DC2626" stop-opacity="0.85" />
        <stop offset="100%" stop-color="#991B1B" stop-opacity="0.9" />
      </linearGradient>

      <filter id={glowId} x="-15%" y="-25%" width="130%" height="150%">
        <feDropShadow dx="0" dy="0" stdDeviation="6" flood-color="#DC2626" flood-opacity="0.72" />
        <feDropShadow dx="0" dy="4" stdDeviation="4" flood-color="#000000" flood-opacity="0.85" />
      </filter>
    </defs>

    <!-- Back arc of black martial arts belt wrapping behind ТАТАМИ (from reference.png) -->
    <path
      d="M196 34 C228 8, 286 4, 326 26 C332 30, 328 42, 316 40 C282 28, 240 28, 206 48 Z"
      fill={`url(#${gradBeltId})`}
      stroke="#DC2626"
      stroke-opacity="0.5"
      stroke-width="1.4"
    />

    <!-- Hanging belt ends on right side -->
    <path
      d="M272 34 L300 32 L338 98 L314 106 L278 52 Z"
      fill={`url(#${gradBeltId})`}
      stroke="#3F3F46"
      stroke-width="1.2"
    />
    <path
      d="M286 38 L318 96"
      stroke="#3F3F46"
      stroke-dasharray="4 3"
      stroke-width="1"
      opacity="0.7"
    />
    <!-- Red rank stripe on belt tip -->
    <path d="M311 94 L331 87 L336 96 L316 104 Z" fill="#DC2626" />

    <!-- Main metallic display wordmark ТАТАМИ -->
    <g filter={`url(#${glowId})`}>
      <text
        x="8"
        y="84"
        fill={`url(#${gradMetalId})`}
        stroke={`url(#${strokeId})`}
        stroke-width="1.5"
        font-family="Montserrat, Inter, system-ui, sans-serif"
        font-weight="900"
        font-size="68"
        letter-spacing="1.5"
      >
        ТАТАМИ
      </text>
    </g>

    <!-- Belt knot overlapping top-right corner of И -->
    <g transform="translate(274, 15)">
      <path
        d="M8 6 C18 -2, 32 0, 36 11 C38 20, 26 27, 14 25 C4 23, 2 12, 8 6 Z"
        fill={`url(#${gradBeltId})`}
        stroke="#DC2626"
        stroke-opacity="0.65"
        stroke-width="1.5"
      />
      <path
        d="M12 10 C20 6, 28 8, 28 15"
        stroke="#52525B"
        stroke-width="1.5"
        stroke-linecap="round"
      />
      <!-- Club patch detail on knot -->
      <rect x="16" y="13" width="12" height="7" rx="1.5" fill="#F4F4F5" opacity="0.9" />
      <rect x="18" y="15" width="8" height="2.5" rx="0.8" fill="#DC2626" />
    </g>
  </svg>

  {showSubtitle && (
    <span class="mt-0.5 pl-1 text-[10px] sm:text-[11px] font-bold uppercase tracking-[0.26em] text-zinc-200">
      Спортивный клуб
    </span>
  )}
</div>
