---
import { Image } from 'astro:assets';
import { TRAINERS } from '../data/site';
import ActionIcon from './ActionIcon.astro';
---
<section id="trainers" class="tatami-section tatami-band-elevated">
  <div class="tatami-container">
    <div class="section-header">
      <h2 class="tatami-section-title">Тренеры клуба</h2>
      <p class="section-note">Наставники, которые работают с детьми и взрослыми и отвечают за технику на ковре.</p>
    </div>
    <div class="trainers-grid">
      {TRAINERS.map((trainer) => (
        <article class="trainer-bio">
          <div class="trainer-poster-frame">
            <Image src={trainer.photo} alt={trainer.name} widths={[320, 480, 720]} sizes="(min-width: 1024px) 31vw, (min-width: 640px) 46vw, 100vw" width={720} format="webp" quality={85} loading="lazy" decoding="async" class="trainer-photo" />
          </div>
          <div class="trainer-card-body">
            <div class="trainer-details">
              <h3 class="sr-only">{trainer.name}</h3>
              <p class="trainer-role">{trainer.role}</p>
              {trainer.achievements.length > 0 ? (
                <ul>{trainer.achievements.map((achievement) => <li>{achievement}</li>)}</ul>
              ) : (
                <p class="trainer-note">Групповые тренировки для детей от 6 лет и взрослых, постановка ударной техники и работа на лапах.</p>
              )}
            </div>
            <a href="#signup" data-select-direction={trainer.directionId} class="btn-compact trainer-booking">{trainer.bookingLabel} <ActionIcon kind="arrow-right" /></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .trainers-grid { display: grid; gap: 24px; }
  .trainer-bio {
    min-width: 0; display: flex; flex-direction: column; overflow: hidden;
    background: var(--surface-alt); border: 1px solid var(--hairline); border-radius: 12px;
  }
  .trainer-poster-frame {
    background: var(--bg-deep);
    border-bottom: 1px solid var(--hairline);
    overflow: hidden;
  }
  .trainer-photo { display: block; width: 100%; height: auto; aspect-ratio: 2 / 3; object-fit: cover; object-position: center; }
  .trainer-card-body { display: flex; flex: 1; flex-direction: column; align-items: start; padding: 24px; }
  .trainer-details { margin-bottom: 24px; width: 100%; }
  .trainer-role {
    display: inline-flex; align-items: center;
    padding: 4px 10px;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 6px;
    color: var(--text);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.35;
  }
  ul { margin-top: 16px; padding-left: 18px; list-style: disc; font-size: 15px; line-height: 1.5; color: var(--secondary); }
  li + li { margin-top: 8px; }
  .trainer-note { margin-top: 16px; font-size: 15px; line-height: 1.5; color: var(--secondary); }
  .trainer-booking { margin-top: auto; }
  @media (min-width: 640px) { .trainers-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .trainers-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
