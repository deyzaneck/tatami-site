---
import { PRICING_PLANS } from '../data/site';
import ActionIcon from './ActionIcon.astro';
---
<section id="pricing" class="tatami-section tatami-band-deep">
  <div class="tatami-container pricing-layout">
    <div>
      <h2 class="tatami-section-title">Стоимость<br />тренировок</h2>
      <p class="section-note mt-6">Выберите абонемент для регулярных занятий или приходите на разовую тренировку.</p>
      <div class="trial-invitation">
        <h3 class="text-lg font-semibold">Пробное занятие бесплатно</h3>
        <p class="mt-2 text-sm leading-6 text-tatami-secondary">Познакомьтесь с тренером и попробуйте занятие в своей группе, прежде чем выбрать абонемент.</p>
        <a href="#signup" data-select-plan="trial" class="btn-primary mt-6">Записаться на пробное</a>
      </div>
    </div>
    <div class="price-list">
      {PRICING_PLANS.map((plan) => (
        <article class="price-row">
          <div><h3>{plan.title}</h3><p>{plan.description}</p></div>
          <div class="price-amount"><span>{plan.price}</span><small>{plan.period}</small><a href="#signup" data-select-plan={plan.id} class="btn-compact price-select">Выбрать <ActionIcon kind="arrow-right" /></a></div>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .pricing-layout { display: grid; gap: 36px; align-items: start; }
  .trial-invitation {
    margin-top: 32px; max-width: 40ch; padding: 24px;
    background: var(--surface); border: 1px solid var(--hairline); border-left: 3px solid var(--accent); border-radius: 12px;
  }
  .price-list { display: grid; gap: 16px; }
  .price-row {
    display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: center;
    padding: 24px; background: var(--surface); border: 1px solid var(--hairline); border-radius: 12px;
  }
  .price-row h3 { font-size: 18px; font-weight: 600; color: var(--text); }
  .price-row p { max-width: 34ch; margin-top: 8px; font-size: 14px; line-height: 20px; color: var(--secondary); }
  .price-amount { display: flex; flex-direction: column; align-items: end; gap: 6px; text-align: right; white-space: nowrap; }
  .price-amount span { font-family: var(--font-display); font-size: 24px; line-height: 30px; font-weight: 500; font-variant-numeric: tabular-nums; }
  .price-amount small { color: var(--secondary); font-size: 14px; }
  .price-select { margin-top: 6px; }
  @media (min-width: 768px) { .pricing-layout { grid-template-columns: 1fr 1.2fr; gap: 64px; } .price-amount span { font-size: 28px; line-height: 34px; } }
</style>
