---
import { PRICING_PLANS } from '../data/site';
---
<section id="pricing" class="tatami-section">
  <div class="tatami-container pricing-layout">
    <div>
      <h2 class="tatami-section-title">Стоимость<br />тренировок</h2>
      <p class="section-note mt-6">Выберите абонемент для регулярных занятий или приходите на разовую тренировку.</p>
      <div class="trial-invitation">
        <h3 class="text-xl font-medium">Пробное занятие бесплатно</h3>
        <p class="mt-3 text-tatami-secondary">Познакомьтесь с тренером и попробуйте занятие в своей группе, прежде чем выбрать абонемент.</p>
        <a href="#signup" class="btn-primary mt-6">Записаться на пробное</a>
      </div>
    </div>
    <div class="price-list">
      {PRICING_PLANS.map((plan) => (
        <article class="price-row">
          <div><h3>{plan.title}</h3><p>{plan.description}</p></div>
          <div class="price-amount"><span>{plan.price}</span><small>{plan.period}</small><a href="#signup" class="text-link">Выбрать</a></div>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .pricing-layout { display: grid; gap: 48px; }
  .trial-invitation { margin-top: 40px; max-width: 38ch; }
  .price-row { display: grid; grid-template-columns: 1fr auto; gap: 24px; padding-block: 24px; border-top: 1px solid var(--hairline); }
  .price-row h3 { font-size: 18px; font-weight: 500; }
  .price-row p { max-width: 34ch; margin-top: 8px; font-size: 14px; line-height: 20px; color: var(--secondary); }
  .price-amount { display: flex; flex-direction: column; align-items: end; gap: 8px; text-align: right; white-space: nowrap; }
  .price-amount span { font-size: 24px; line-height: 32px; font-variant-numeric: tabular-nums; }
  .price-amount small { color: var(--secondary); font-size: 14px; }
  .price-amount a { padding-block: 8px; font-size: 14px; }
  @media (min-width: 768px) { .pricing-layout { grid-template-columns: 1fr 1.2fr; gap: 96px; } .price-amount span { font-size: 28px; } }
</style>
