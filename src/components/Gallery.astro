---
import { Image, getImage } from 'astro:assets';
import { GALLERY_PHOTOS } from '../data/gallery';

const categories = ['Все', 'Тренировки', 'Залы', 'Клуб'] as const;

const galleryWithFullRes = await Promise.all(
  GALLERY_PHOTOS.map(async (photo, index) => {
    const full = await getImage({
      src: photo.src,
      width: Math.min(photo.src.width, 1440),
      format: 'webp',
      quality: 84,
    });
    return { ...photo, index, fullSrc: full.src };
  }),
);
---

<section id="gallery" class="tatami-section tatami-band-deep">
  <div class="tatami-container">
    <div class="section-header">
      <div>
        <h2 class="tatami-section-title">Наш зал и тренировки</h2>
      </div>
      <p class="section-note">Реальные фотографии залов клуба «Татами» на ул. Гагарина, 85: два просторных помещения, новые красные татами и рабочая атмосфера.</p>
    </div>

    <div class="gallery-filters" role="group" aria-label="Фильтр фотографий по категориям">
      {categories.map((category) => (
        <button
          type="button"
          data-gallery-filter={category}
          aria-pressed={category === 'Все' ? 'true' : 'false'}
          class="gallery-filter-btn"
        >
          {category}
        </button>
      ))}
    </div>

    <div class="gallery-grid">
      {galleryWithFullRes.map((item) => (
        <figure data-category={item.category} class="gallery-figure">
          <button
            type="button"
            data-gallery-item
            data-category={item.category}
            data-index={item.index}
            data-full-src={item.fullSrc}
            data-alt={item.alt}
            data-caption={item.caption}
            class="gallery-thumb group"
            aria-label={`${item.caption} — открыть фото ${item.index + 1} из ${galleryWithFullRes.length}`}
          >
            <Image
              src={item.src}
              alt={item.alt}
              width={item.src.width}
              height={item.src.height}
              quality={82}
              format="webp"
              widths={[360, 640, 960]}
              sizes="(min-width: 1024px) 31vw, (min-width: 640px) 46vw, 100vw"
              loading="lazy"
              decoding="async"
              class={`gallery-img ${item.objectPosition}`}
            />
          </button>
          <figcaption class="gallery-caption">{item.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>

  <dialog id="tatami-lightbox" aria-label="Просмотр фотографии галереи">
    <button type="button" id="lightbox-close" class="lightbox-btn lightbox-close" aria-label="Закрыть просмотр (Esc)">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m6 6 12 12M6 18 18 6" /></svg>
    </button>
    <button type="button" id="lightbox-prev" class="lightbox-btn lightbox-prev" aria-label="Предыдущее фото">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6" /></svg>
    </button>
    <figure class="lightbox-figure">
      <img id="lightbox-img" src="" alt="" />
      <figcaption>
        <p id="lightbox-caption"></p>
        <span id="lightbox-counter"></span>
      </figcaption>
    </figure>
    <button type="button" id="lightbox-next" class="lightbox-btn lightbox-next" aria-label="Следующее фото">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6" /></svg>
    </button>
  </dialog>
</section>

<script>
  const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-filter]'));
  const figures = Array.from(document.querySelectorAll<HTMLElement>('.gallery-figure'));
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-item]'));
  const modal = document.getElementById('tatami-lightbox') as HTMLDialogElement | null;
  const imgEl = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const captionEl = document.getElementById('lightbox-caption');
  const counterEl = document.getElementById('lightbox-counter');
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');

  interface SlideItem {
    src: string;
    alt: string;
    caption: string;
  }

  let visibleItems: SlideItem[] = [];

  const getVisibleItems = (): SlideItem[] =>
    triggers
      .filter((button) => !button.closest('figure')?.hidden)
      .map((button) => ({
        src: button.dataset.fullSrc || '',
        alt: button.dataset.alt || '',
        caption: button.dataset.caption || '',
      }));

  visibleItems = getVisibleItems();

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.dataset.galleryFilter || 'Все';
      filterButtons.forEach((other) => {
        other.setAttribute('aria-pressed', String(other === btn));
      });
      figures.forEach((figure) => {
        const category = figure.dataset.category || '';
        figure.hidden = selected !== 'Все' && category !== selected;
      });
      visibleItems = getVisibleItems();
    });
  });

  if (modal && imgEl && captionEl && counterEl && closeBtn && prevBtn && nextBtn && triggers.length > 0) {
    let currentIndex = 0;
    let lastFocused: HTMLElement | null = null;
    let previousOverflow = '';
    let touchStartX = 0;
    let touchStartY = 0;
    let isMultiTouch = false;

    const preloadSlide = (index: number) => {
      if (visibleItems.length < 2) return;
      const item = visibleItems[(index + visibleItems.length) % visibleItems.length];
      if (item?.src) {
        const preloader = new Image();
        preloader.src = item.src;
      }
    };

    const renderSlide = (index: number) => {
      if (visibleItems.length === 0) return;
      currentIndex = (index + visibleItems.length) % visibleItems.length;
      const item = visibleItems[currentIndex];
      imgEl.src = item.src;
      imgEl.alt = item.alt;
      captionEl.textContent = item.caption;
      counterEl.textContent = `${currentIndex + 1} / ${visibleItems.length}`;
      preloadSlide(currentIndex - 1);
      preloadSlide(currentIndex + 1);
    };

    const openModal = (trigger: HTMLButtonElement) => {
      visibleItems = getVisibleItems();
      const visibleTriggers = triggers.filter((button) => !button.closest('figure')?.hidden);
      const index = Math.max(0, visibleTriggers.indexOf(trigger));
      lastFocused = trigger;
      previousOverflow = document.body.style.overflow;
      renderSlide(index);
      document.body.style.overflow = 'hidden';
      modal.showModal();
      closeBtn.focus();
    };

    triggers.forEach((button) => button.addEventListener('click', () => openModal(button)));
    closeBtn.addEventListener('click', () => modal.close());
    prevBtn.addEventListener('click', () => renderSlide(currentIndex - 1));
    nextBtn.addEventListener('click', () => renderSlide(currentIndex + 1));

    modal.addEventListener('click', (event) => {
      if (event.target === modal) modal.close();
    });

    modal.addEventListener('close', () => {
      document.body.style.overflow = previousOverflow;
      lastFocused?.focus();
      lastFocused = null;
    });

    modal.addEventListener('touchstart', (event) => {
      if (event.touches.length > 1) {
        isMultiTouch = true;
        return;
      }
      isMultiTouch = false;
      touchStartX = event.touches[0]?.clientX ?? 0;
      touchStartY = event.touches[0]?.clientY ?? 0;
    }, { passive: true });

    modal.addEventListener('touchend', (event) => {
      if (isMultiTouch || event.touches.length > 0) return;
      const touch = event.changedTouches[0];
      if (!touch) return;
      const deltaX = touch.clientX - touchStartX;
      const deltaY = touch.clientY - touchStartY;
      if (Math.abs(deltaX) > 45 && Math.abs(deltaX) > Math.abs(deltaY) * 1.5) {
        renderSlide(deltaX > 0 ? currentIndex - 1 : currentIndex + 1);
      }
    }, { passive: true });

    document.addEventListener('keydown', (event) => {
      if (!modal.open) return;
      if (event.key === 'ArrowLeft') { event.preventDefault(); renderSlide(currentIndex - 1); }
      else if (event.key === 'ArrowRight') { event.preventDefault(); renderSlide(currentIndex + 1); }
    });
  }
</script>

<style>
  [hidden] { display: none !important; }
  .gallery-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 28px;
  }
  .gallery-filter-btn {
    min-height: 44px;
    padding: 8px 18px;
    border-radius: 8px;
    border: 1px solid var(--hairline);
    background: var(--surface);
    color: var(--secondary);
    font-size: 14px;
    font-weight: 500;
    transition: background-color 160ms var(--ease), border-color 160ms var(--ease), color 160ms var(--ease);
  }
  .gallery-filter-btn:hover {
    color: var(--text);
    border-color: rgb(232 227 217 / 28%);
  }
  .gallery-filter-btn[aria-pressed='true'] {
    background: var(--text);
    color: var(--page);
    border-color: var(--text);
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  .gallery-figure { min-width: 0; }
  .gallery-thumb {
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--hairline);
    background: var(--surface);
    text-align: left;
    cursor: pointer;
  }
  .gallery-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: opacity 150ms var(--ease);
  }
  .gallery-img.object-top { object-position: top; }
  .gallery-img.object-center { object-position: center; }
  .gallery-thumb:hover .gallery-img { opacity: 0.9; }
  .gallery-caption {
    padding-top: 12px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--text);
  }
  #tatami-lightbox {
    margin: 0;
    padding: 16px;
    border: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    background: rgb(14 14 15 / 94%);
    color: var(--text);
    overscroll-behavior: contain;
  }
  #tatami-lightbox[open] {
    display: grid;
    place-items: center;
  }
  #tatami-lightbox::backdrop {
    background: rgb(14 14 15 / 92%);
  }
  .lightbox-figure {
    display: flex;
    max-height: 90vh;
    max-width: min(1024px, calc(100vw - 32px));
    flex-direction: column;
    align-items: center;
    pointer-events: none;
  }
  .lightbox-figure img {
    max-height: 76vh;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    border-radius: 8px;
    pointer-events: auto;
  }
  .lightbox-figure figcaption {
    margin-top: 16px;
    text-align: center;
    pointer-events: auto;
  }
  #lightbox-caption {
    font-size: 16px;
    line-height: 1.5;
    color: var(--text);
  }
  #lightbox-counter {
    display: block;
    margin-top: 4px;
    font-size: 14px;
    color: var(--muted);
  }
  .lightbox-btn {
    position: fixed;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    border: 1px solid rgb(232 227 217 / 14%);
    background: var(--raised);
    color: var(--text);
    transition: background-color 160ms var(--ease), border-color 160ms var(--ease);
  }
  .lightbox-btn:hover {
    background: #312e2b;
    border-color: rgb(232 227 217 / 28%);
  }
  .lightbox-close {
    width: 44px;
    height: 44px;
    top: max(16px, env(safe-area-inset-top));
    right: max(16px, env(safe-area-inset-right));
  }
  .lightbox-prev, .lightbox-next {
    width: 48px;
    height: 48px;
    top: 50%;
    transform: translateY(-50%);
  }
  .lightbox-prev { left: max(12px, env(safe-area-inset-left)); }
  .lightbox-next { right: max(12px, env(safe-area-inset-right)); }
  @media (min-width: 640px) {
    .gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .lightbox-prev { left: 24px; }
    .lightbox-next { right: 24px; }
  }
  @media (min-width: 1024px) {
    .gallery-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
