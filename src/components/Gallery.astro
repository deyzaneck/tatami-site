---
import { Image, getImage } from 'astro:assets';
import { GALLERY_PHOTOS } from '../data/gallery';

const galleryWithFullRes = await Promise.all(
  GALLERY_PHOTOS.map(async (photo, index) => {
    const full = await getImage({
      src: photo.src,
      width: Math.min(photo.src.width, 1600),
      format: 'webp',
      quality: 86,
    });
    return { ...photo, index, fullSrc: full.src };
  }),
);
---

<section id="gallery" class="tatami-section border-t border-tatami-border">
  <div class="tatami-container">
    <div class="section-header">
      <div>
        <h2 class="tatami-section-title">Наш зал и тренировки</h2>
      </div>
      <p class="section-note">Реальные фотографии залов клуба «Татами» на ул. Гагарина, 85: два просторных помещения, новые красные татами и рабочая атмосфера.</p>
    </div>

    <div class="columns-1 gap-6 sm:columns-2 lg:columns-3">
      {galleryWithFullRes.map((item) => (
        <figure class="mb-8 break-inside-avoid">
          <button
            type="button"
            data-gallery-item
            data-index={item.index}
            data-full-src={item.fullSrc}
            data-alt={item.alt}
            data-caption={item.caption}
            class="group block w-full overflow-hidden rounded-xl bg-tatami-card text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-tatami-red focus-visible:ring-offset-2 focus-visible:ring-offset-tatami-bg"
            aria-label={`${item.caption} — открыть фото ${item.index + 1} из ${galleryWithFullRes.length}`}
          >
            <Image
              src={item.src}
              alt={item.alt}
              width={item.src.width}
              height={item.src.height}
              quality={82}
              format="webp"
              widths={[320, 480, 640, 960]}
              sizes="(min-width: 1024px) 31vw, (min-width: 640px) 48vw, 100vw"
              loading="lazy"
              decoding="async"
              class={`block h-auto w-full object-contain transition-opacity duration-150 group-hover:opacity-90 ${item.objectPosition}`}
            />
          </button>
          <figcaption class="pt-3 text-base leading-6 text-tatami-text">{item.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>

  <div
    id="tatami-lightbox"
    role="dialog"
    aria-modal="true"
    aria-label="Просмотр фотографии галереи"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-tatami-bg/95 p-4"
    tabindex="-1"
  >
    <button type="button" id="lightbox-close" class="absolute right-4 top-4 z-10 inline-flex h-11 w-11 items-center justify-center rounded-lg border border-tatami-border bg-tatami-card text-tatami-text transition hover:border-tatami-red focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-tatami-red" aria-label="Закрыть просмотр (Esc)">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m6 6 12 12M6 18 18 6" /></svg>
    </button>
    <button type="button" id="lightbox-prev" class="absolute left-3 top-1/2 z-10 inline-flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-lg border border-tatami-border bg-tatami-card text-tatami-text transition hover:border-tatami-red focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-tatami-red sm:left-6" aria-label="Предыдущее фото">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6" /></svg>
    </button>
    <figure class="flex max-h-[90vh] max-w-5xl flex-col items-center">
      <img id="lightbox-img" src="" alt="" class="max-h-[78vh] w-auto max-w-full object-contain" />
      <figcaption class="mt-4 text-center">
        <p id="lightbox-caption" class="text-base leading-6 text-tatami-text"></p>
        <span id="lightbox-counter" class="mt-1 block text-sm text-tatami-muted"></span>
      </figcaption>
    </figure>
    <button type="button" id="lightbox-next" class="absolute right-3 top-1/2 z-10 inline-flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-lg border border-tatami-border bg-tatami-card text-tatami-text transition hover:border-tatami-red focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-tatami-red sm:right-6" aria-label="Следующее фото">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6" /></svg>
    </button>
  </div>
</section>

<script>
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-item]'));
  const modal = document.getElementById('tatami-lightbox');
  const imgEl = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const captionEl = document.getElementById('lightbox-caption');
  const counterEl = document.getElementById('lightbox-counter');
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');

  if (modal && imgEl && captionEl && counterEl && closeBtn && prevBtn && nextBtn && triggers.length > 0) {
    const items = triggers.map((button) => ({ src: button.dataset.fullSrc || '', alt: button.dataset.alt || '', caption: button.dataset.caption || '' }));
    const focusable = [closeBtn, prevBtn, nextBtn];
    let currentIndex = 0;
    let lastFocused: HTMLElement | null = null;
    let previousOverflow = '';
    let touchStartX = 0;

    const renderSlide = (index: number) => {
      currentIndex = (index + items.length) % items.length;
      const item = items[currentIndex];
      imgEl.src = item.src;
      imgEl.alt = item.alt;
      captionEl.textContent = item.caption;
      counterEl.textContent = `${currentIndex + 1} / ${items.length}`;
    };

    const openModal = (index: number, trigger: HTMLElement) => {
      lastFocused = trigger;
      previousOverflow = document.body.style.overflow;
      renderSlide(index);
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    };

    const closeModal = () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = previousOverflow;
      lastFocused?.focus();
      lastFocused = null;
    };

    triggers.forEach((button, index) => button.addEventListener('click', () => openModal(index, button)));
    closeBtn.addEventListener('click', closeModal);
    prevBtn.addEventListener('click', () => renderSlide(currentIndex - 1));
    nextBtn.addEventListener('click', () => renderSlide(currentIndex + 1));
    modal.addEventListener('click', (event) => { if (event.target === modal) closeModal(); });
    modal.addEventListener('touchstart', (event) => { touchStartX = event.changedTouches[0]?.clientX ?? 0; }, { passive: true });
    modal.addEventListener('touchend', (event) => {
      const delta = (event.changedTouches[0]?.clientX ?? 0) - touchStartX;
      if (Math.abs(delta) > 45) renderSlide(delta > 0 ? currentIndex - 1 : currentIndex + 1);
    }, { passive: true });

    document.addEventListener('keydown', (event) => {
      if (modal.classList.contains('hidden')) return;
      if (event.key === 'Escape') { event.preventDefault(); closeModal(); return; }
      if (event.key === 'ArrowLeft') { event.preventDefault(); renderSlide(currentIndex - 1); return; }
      if (event.key === 'ArrowRight') { event.preventDefault(); renderSlide(currentIndex + 1); return; }
      if (event.key === 'Tab') {
        const current = document.activeElement;
        const index = focusable.indexOf(current as HTMLButtonElement);
        if (event.shiftKey && (index <= 0 || current === modal)) { event.preventDefault(); focusable[focusable.length - 1].focus(); }
        else if (!event.shiftKey && index === focusable.length - 1) { event.preventDefault(); focusable[0].focus(); }
      }
    });
  }
</script>

<style>
  #tatami-lightbox { overscroll-behavior: contain; }
  #lightbox-close { top: max(16px, env(safe-area-inset-top)); right: max(16px, env(safe-area-inset-right)); }
</style>
