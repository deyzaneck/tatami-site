---
import { CLUB, HERO_MEDIA } from '../data/site';
import heroMobile from '../assets/hero-athlete-mobile.webp';
import ActionIcon from './ActionIcon.astro';
---

<section id="hero" class="hero tatami-band-deep">
  <div class="tatami-container hero-layout">
    <div class="hero-copy">
      <p class="hero-location">{CLUB.cityShort}, {CLUB.streetAddress}</p>
      <h1>Дзюдо, тайский бокс<br />Стретчинг</h1>
      <p class="hero-intro">
        «Татами» — спортивный клуб с занятиями по дзюдо, тайскому боксу и стретчингу.
      </p>
      <p class="hero-trial">Первое занятие — бесплатно</p>
      <div class="hero-actions">
        <a href="#signup" class="btn-primary">Записаться на пробное</a>
        <a href="#directions" class="btn-secondary">Выбрать направление <ActionIcon kind="arrow-down" /></a>
      </div>
    </div>
    <div class="hero-visual">
      <picture>
        <source media="(max-width: 767px)" srcset={heroMobile.src} />
        <img
          src={HERO_MEDIA.imageSrc}
          srcset={`${heroMobile.src} ${heroMobile.width}w, ${HERO_MEDIA.imageSrc} ${HERO_MEDIA.imageWidth}w`}
          sizes="(max-width: 767px) 100vw, 50vw"
          alt="Спортсмен в белом кимоно на тёмном фоне — иллюстрация клуба «Татами»"
          width={HERO_MEDIA.imageWidth}
          height={HERO_MEDIA.imageHeight}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>
  </div>
</section>

<style>
  .hero { overflow: hidden; }
  .hero-layout { display: grid; }
  .hero-copy { padding-block: 40px 32px; position: relative; z-index: 1; }
  .hero-location { color: var(--secondary); font-size: 14px; margin-bottom: 20px; }
  h1 {
    font-family: var(--font-display);
    max-width: 15em;
    font-size: 32px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }
  .hero-intro { margin-top: 20px; max-width: 38ch; font-size: 17px; line-height: 26px; color: var(--secondary); }
  .hero-trial { margin-top: 20px; font-size: 15px; font-weight: 500; color: var(--text); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; margin-top: 24px; }
  .hero-visual { height: 320px; margin-inline: -24px; overflow: hidden; }
  .hero-visual picture { display: block; width: 100%; height: 100%; }
  .hero-visual img { width: 100%; height: 100%; object-fit: cover; object-position: 78% center; }
  @media (min-width: 768px) {
    .hero-layout { grid-template-columns: 1.15fr 1fr; min-height: 620px; align-items: center; }
    .hero-copy { padding-block: 72px; }
    h1 { font-size: clamp(36px, 3.4vw, 48px); }
    .hero-visual { align-self: stretch; height: auto; min-height: 100%; margin: 0 -32px 0 -100px; }
    .hero-visual img { object-position: 74% center; mask-image: linear-gradient(to right, transparent, #000 28%); }
  }
  @media (min-width: 1200px) {
    .hero-layout { grid-template-columns: 1.2fr 1fr; min-height: 660px; }
    .hero-copy { padding-block: 80px; }
    .hero-visual { margin-left: -80px; }
  }
</style>
